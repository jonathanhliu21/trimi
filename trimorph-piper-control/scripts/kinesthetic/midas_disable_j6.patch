index 0000000..596d0c3
--- /dev/null
+++ b/gravity_comp/can_trace.py
@@ -0,0 +1,79 @@
+"""Bounded capture of packed frames passed to the SDK's CAN transport.
+
+The tap forwards each send exactly once. It neither sends extra frames nor
+changes SocketCAN loopback. A successful send confirms SDK transport success,
+not that a motor applied the command. File I/O occurs only after the run.
+"""
+from collections import deque
+from pathlib import Path
+import time
+
+import numpy as np
+
+
+class CanTxTrace:
+    def __init__(self, *, head_frames=12000, tail_frames=120000):
+        if head_frames < 0 or tail_frames <= 0:
+            raise ValueError("Trace sizes must be nonnegative head and positive tail")
+        self.head_frames = head_frames
+        self.head = []
+        self.tail = deque(maxlen=tail_frames)
+        self.total = 0
+        self.comm = None
+        self.original_send = None
+        self.tap = None
+
+    def attach(self, robot):
+        if self.comm is not None:
+            raise RuntimeError("Trace already attached")
+        comm = robot.get_context().get_comm()
+        if comm is None:
+            raise RuntimeError("Cannot trace a disconnected SDK transport")
+        original = comm.send
+
+        def tap(msg, *args, **kwargs):
+            # Timestamp and bytes refer to this particular packed command,
+            # before any later call can reuse/mutate a message object.
+            row = (time.monotonic(), int(msg.arbitration_id), bytes(msg.data))
+            ok = False
+            try:
+                result = original(msg, *args, **kwargs)
+                ok = result is not False
+                return result
+            finally:
+                entry = (*row, ok)
+                if len(self.head) < self.head_frames:
+                    self.head.append(entry)
+                else:
+                    self.tail.append(entry)
+                self.total += 1
+
+        self.comm, self.original_send, self.tap = comm, original, tap
+        comm.send = tap
+
+    def detach(self):
+        if self.comm is not None:
+            if self.comm.send is self.tap:
+                self.comm.send = self.original_send
+            self.comm = None
+
+    def save(self, path):
+        rows = self.head + list(self.tail)
+        data = np.zeros((len(rows), 8), dtype=np.uint8)
+        for i, (_, _, payload, _) in enumerate(rows):
+            if len(payload) > 8:
+                raise ValueError("Trace expects classic CAN payloads of at most 8 bytes")
+            data[i, :len(payload)] = list(payload)
+        path = Path(path)
+        with path.open("wb") as stream:
+            np.savez_compressed(
+                stream,
+                t=np.asarray([r[0] for r in rows], dtype=float),
+                can_id=np.asarray([r[1] for r in rows], dtype=np.uint32),
+                dlc=np.asarray([len(r[2]) for r in rows], dtype=np.uint8),
+                data=data,
+                send_ok=np.asarray([r[3] for r in rows], dtype=bool),
+                total_frames=np.asarray(self.total),
+                dropped_frames=np.asarray(self.total - len(rows)),
+            )
+        return path
