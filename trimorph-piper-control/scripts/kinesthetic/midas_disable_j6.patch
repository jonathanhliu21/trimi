index 0000000..e7d6b72
--- /dev/null
+++ b/gravity_comp/tests/test_can_trace.py
@@ -0,0 +1,109 @@
+"""A trace must preserve SDK behavior, including send errors, without CAN."""
+from types import SimpleNamespace as NS
+
+import numpy as np
+import pytest
+
+from gravity_comp.can_trace import CanTxTrace
+
+
+def attach(trace, send):
+    comm = NS(send=send)
+    robot = NS(get_context=lambda: NS(get_comm=lambda: comm))
+    trace.attach(robot)
+    return comm
+
+
+def test_trace_retains_start_and_bounded_tail_and_forwards_once(tmp_path):
+    sent = []
+    def send(msg, *args, **kwargs):
+        sent.append((msg.arbitration_id, bytes(msg.data), args, kwargs))
+        return True
+    trace = CanTxTrace(head_frames=2, tail_frames=3)
+    comm = attach(trace, send)
+    for i in range(8):
+        msg = NS(arbitration_id=0x151 + i, data=bytearray([i] * 8))
+        assert comm.send(msg, timeout=.1) is True
+        msg.data[0] = 255
+    trace.detach()
+    assert comm.send is send
+    assert len(sent) == 8
+    assert all(row[3] == {"timeout": .1} for row in sent)
+    out = np.load(trace.save(tmp_path / "trace.npz"))
+    assert out["can_id"].tolist() == [0x151 + i for i in (0, 1, 5, 6, 7)]
+    assert out["data"][:, 0].tolist() == [0, 1, 5, 6, 7]
+    assert out["total_frames"] == 8
+    assert out["dropped_frames"] == 3
+    assert out["send_ok"].all()
+
+
+def test_transport_error_is_preserved_and_recorded(tmp_path):
+    fault = RuntimeError("CAN send failed")
+    def send(msg):
+        raise fault
+    trace = CanTxTrace()
+    comm = attach(trace, send)
+    with pytest.raises(RuntimeError) as caught:
+        comm.send(NS(arbitration_id=0x15A, data=b"abcdefgh"))
+    assert caught.value is fault
+    trace.detach()
+    out = np.load(trace.save(tmp_path / "trace.npz"))
+    assert out["send_ok"].tolist() == [False]
+
+
+def test_empty_trace_has_stable_payload_shape(tmp_path):
+    trace = CanTxTrace()
+    out = np.load(trace.save(tmp_path / "empty.npz"))
+    assert out["data"].shape == (0, 8)
+
+
+@pytest.mark.parametrize("both", [False, True])
+def test_passive_wrist_real_sdk_packs_original_mode_and_zero_gains(tmp_path, both):
+    # Exercise the installed SDK's actual encoder; no connect() and no CAN
+    # transport are used. Mocking move_mit would miss a packing regression.
+    pytest.importorskip("pyAgxArm")
+    from scripts.piper_api.robot_helpers import create_piper_robot
+    from scripts.piper_api.piper_api import PiperAPI
+    from gravity_comp.hw_session import HardwareSession
+    from gravity_comp.control import DragController
+    from gravity_comp.tests.test_control import make_config, Q_MID, const_gravity
+    from uuid import uuid4
+
+    robot = create_piper_robot(firmware="v183", interface="virtual", channel="offline-" + uuid4().hex)
+    transmitted = []
+    # Intercept the transport after the actual message encoder runs.
+    robot.get_context().comm = NS(send=lambda msg: transmitted.append(msg) or True)
+    trace = CanTxTrace()
+    trace.attach(robot)
+    api = PiperAPI(firmware="v183", installation_pos=None, payload=None, robot=robot)
+    session = HardwareSession("v183", passive_j6=not both, passive_j5_j6=both)
+    session.api = api
+    kd = np.full(6, .01)
+    kd[4] = .005
+    ctrl = DragController(make_config(kd_mit=kd), const_gravity)
+    ctrl.start(Q_MID)
+    api.set_mit_mode()
+    session.send_mit(ctrl.update(Q_MID, np.zeros(6), 2.))
+    trace.detach()
+    rows = np.load(trace.save(tmp_path / "packed.npz"))
+    ids = rows["can_id"].tolist()
+    assert ids == [0x151] + [v for j in range(6) for v in (0x151, 0x15A + j)]
+    mode_data = rows["data"][rows["can_id"] == 0x151]
+    assert (mode_data == mode_data[0]).all()
+    assert mode_data[0, :4].tolist() == [1, 4, 50, 0xAD]
+    mit_data = rows["data"][rows["can_id"] >= 0x15A]
+    for data in mit_data:
+        kp_bits = ((int(data[3]) & 15) << 8) | int(data[4])
+        assert kp_bits == 0
+        assert int(data[7]) & 15 == int(np.bitwise_xor.reduce(data[:7])) & 15
+    j5 = mit_data[4]
+    assert (int(j5[5]) << 4) | (int(j5[6]) >> 4) == (2047 if both else 2049)
+    # V183's signed ranges have no exactly-zero code: these are its zero
+    # request encodings, not a claim of exactly zero measured motor torque.
+    for wrist in mit_data[4 if both else 5:]:
+        kd_bits = (int(wrist[5]) << 4) | (int(wrist[6]) >> 4)
+        torque_bits = ((int(wrist[6]) & 15) << 4) | (int(wrist[7]) >> 4)
+        assert kd_bits == 2047
+        assert torque_bits == 127
+    assert len(transmitted) == 13
+    robot.get_context().comm = None
