@@ -0,0 +1,84 @@
+"""Exercise automatic freezes through the real I/O loop, without hardware."""
+from types import SimpleNamespace as NS
+from unittest.mock import Mock
+
+import numpy as np
+import pytest
+
+from gravity_comp import drag_mode as dm
+from gravity_comp.hw_session import HardwareSession, StateSample
+from gravity_comp.tests.test_control import make_config, Q_MID, const_gravity
+
+
+@pytest.mark.parametrize("failure,at_s,reason", [
+    ("missing", .2, "stale feedback"),  # During ramp-in.
+    ("missing", 1.2, "stale feedback"),  # Waiting for assist steps.
+    ("runaway", 1.2, "runaway J6"),
+])
+def test_automatic_freeze_is_visible_latched_and_saved(monkeypatch, capsys, failure, at_s, reason):
+    clock = NS(now=0.)
+    monkeypatch.setattr(dm, "time", NS(monotonic=lambda: clock.now,
+                                      sleep=lambda dt: setattr(clock, "now", clock.now + dt)))
+    monkeypatch.setattr(dm.signal, "signal", lambda *args: None)
+    artifact = Mock(robot_id="test")
+    artifact.payload_mass_com.return_value = (0., np.zeros(3))
+    monkeypatch.setattr(dm.CalibrationArtifact, "load", lambda path: artifact)
+    monkeypatch.setattr(dm, "ArmGravityModel", lambda **kw: NS(gravity_torques=const_gravity))
+    cfg = make_config(ramp_in_s=1.)
+    info = dict(underpowered_diagnostic=True, underpowered_joints=[1, 2],
+                tau_cap_nm=[8.] * 6, command_scales_nm=[1.] * 6,
+                firmware_limits_nm=[30.] * 6, cap_fraction_of_limit=[8./30.] * 6)
+    monkeypatch.setattr(dm, "build_drag_config", lambda *a, **kw: (cfg, info, cfg.assist_nm.copy()))
+    monkeypatch.setattr(dm, "print_ritual", lambda *args: None)
+    monkeypatch.setattr(dm, "enter_to_arm", lambda *args: None)
+    monkeypatch.setattr(dm, "print_gate_table", lambda *args: True)
+    monkeypatch.setattr(dm, "refuse_or_force", lambda *args: True)
+    save = Mock(return_value="test.npz")
+    monkeypatch.setattr(dm, "save_run", save)
+    session = Mock(command_scales=np.ones(6))
+    session.passive_joint_fault.return_value = None
+    def send(cmd):
+        session.last_mit_command = {
+            name: getattr(cmd, name).copy() for name in ("kp", "kd", "p_des", "v_des")
+        }
+        return np.asarray(cmd.t_ff)
+    session.send_mit.side_effect = send
+
+    def read():
+        broken = at_s <= clock.now < at_s + .4
+        if broken and failure == "missing":
+            raise RuntimeError("No joint-angle feedback from Piper; motor positions (deg): 0 0 0 0 0 361")
+        v = np.zeros(6)
+        if broken and failure == "runaway":
+            v[5] = 8.
+        return StateSample(q=Q_MID.copy(), v=v, tau_fb=np.zeros(6), current=np.zeros(6),
+                           t_wall=clock.now, feedback_hz=200., t_feedback=clock.now, t_joint=clock.now)
+
+    session.read_state.side_effect = read
+    monkeypatch.setattr(dm, "HardwareSession", lambda *a, **kw: session)
+    keys = Mock()
+    # Fresh feedback and repeated Enter presses after the fault must not
+    # resume assist or print READY. Operator q still shuts down normally.
+    keys.pressed.side_effect = lambda: "q" if clock.now > 3. else ("\n" if clock.now > 2. else None)
+    monkeypatch.setattr(dm, "KeyGate", lambda: keys)
+    assert dm.main(["--calib", "fake.json", "--disable-j6", "--force"]) == 0
+    out = capsys.readouterr().out
+    assert f"freeze requested: {reason}" in out
+    assert "J6 remains free" in out
+    assert "assist at target" not in out
+    assert "assist at 20%" not in out
+    assert "FREEZE_HOLD" in save.call_args.args[1]["state"]
+    event = save.call_args.args[2]["freeze_event"]
+    assert event["reason"] == reason
+    if failure == "missing":
+        assert "361" in event["feedback_problem"]
+    session.disable_after_confirm.assert_called_once()
+
+
+def test_missing_joint_feedback_reports_motor_positions_without_accepting_them():
+    session = HardwareSession("v183")
+    session.api = Mock()
+    session.api.get_joint_state.return_value = None
+    session.api.get_motor_state.return_value = NS(positions=np.deg2rad([0, 0, 0, 0, 0, 361]))
+    with pytest.raises(RuntimeError, match="No joint-angle feedback.*361.00"):
+        session.read_state()
