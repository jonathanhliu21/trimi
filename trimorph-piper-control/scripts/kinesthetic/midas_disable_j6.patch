+"""Collection's J5 damping override must not weaken brake or hold damping."""
+from types import SimpleNamespace as NS
+
+import numpy as np
+import pytest
+
+from gravity_comp.control import DragController, DragState
+from gravity_comp.drag_mode import build_drag_config, parse_args
+from gravity_comp.tests.test_control import Q_MID, const_gravity
+from gravity_comp.poses import JOINT_LIMITS
+
+
+def config(j5_kd=None):
+    artifact = NS(alpha=lambda: np.ones(6), coulomb=lambda: np.full(6, .3),
+                  section=lambda name: {}, velocity_noise_sigma=lambda: np.full(6, .001),
+                  torque_limits=lambda: np.full(6, 30.), output_scales=lambda: np.ones(6))
+    model = NS(max_gravity_torque_bound=lambda: np.ones(6), joint_limits=lambda: JOINT_LIMITS)
+    return build_drag_config(artifact, model, .3, j5_kd=j5_kd)
+
+
+def test_j5_override_applies_during_drag_but_preserves_brake_and_hold():
+    baseline, _, _ = config()
+    cfg, info, _ = config(.005)
+    expected = np.array([.01, .01, .01, .01, .005, .01])
+    np.testing.assert_array_equal(baseline.kd_mit, np.full(6, .01))
+    np.testing.assert_array_equal(cfg.kd_mit, expected)
+    np.testing.assert_array_equal(info["kd_mit"], expected)
+    np.testing.assert_array_equal(cfg.kd_soft, baseline.kd_soft)
+    ctrl = DragController(cfg, const_gravity)
+    ctrl.start(Q_MID)
+    for dt, state in ((.1, DragState.RAMP_IN), (4., DragState.ACTIVE)):
+        cmd = ctrl.update(Q_MID, np.zeros(6), dt)
+        assert ctrl.state == state
+        np.testing.assert_array_equal(cmd.kd, expected)
+    ctrl.freeze("test")
+    cmd = ctrl.update(Q_MID, np.zeros(6), .01)
+    np.testing.assert_array_equal(cmd.kd, np.full(6, baseline.brake_kd))
+    cmd = ctrl.update(Q_MID, np.zeros(6), 1.)
+    assert ctrl.state == DragState.FREEZE_HOLD
+    np.testing.assert_array_equal(cmd.kd, np.full(6, baseline.hold_kd))
+
+
+@pytest.mark.parametrize("value", ["nan", "inf", "-inf", "-0.001", "5.001"])
+def test_bad_override_is_rejected_before_connect(value):
+    with pytest.raises(SystemExit) as exc:
+        parse_args(["--j5-kd=" + value])
+    assert exc.value.code == 2
