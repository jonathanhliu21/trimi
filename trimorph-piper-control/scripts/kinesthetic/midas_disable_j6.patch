+"""Disabled/passive wrist contracts, exercised without CAN or motors."""
+from itertools import combinations
+import time
+from types import SimpleNamespace as NS
+from unittest.mock import Mock, patch
+
+import numpy as np
+import pytest
+
+from gravity_comp.hw_session import HardwareSession, damp_brake
+from gravity_comp.control import DragController, DragState
+from gravity_comp.tests.test_control import make_config, Q_MID, const_gravity
+
+
+def session(*, passive_j6=False, passive_j5_j6=False):
+    s = HardwareSession("v183", disable_j6=not (passive_j6 or passive_j5_j6),
+                        passive_j6=passive_j6, passive_j5_j6=passive_j5_j6)
+    enabled = [False] * 6
+    def state(j):
+        return NS(timestamp=time.time(), msg=NS(foc_status=NS(driver_enable_status=enabled[j-1])))
+    robot = Mock()
+    robot.get_driver_states.side_effect = state
+    robot.disable.side_effect = lambda j: enabled.__setitem__(j-1, False)
+    robot.enable.side_effect = lambda j: enabled.__setitem__(j-1, True)
+    s.api = Mock(robot=robot)
+    s.api.move_mit_torque.side_effect = lambda j, torque, **kw: torque
+    return s, enabled
+
+
+def test_selective_enable_and_passive_feedback_faults():
+    s, enabled = session()
+    with patch("gravity_comp.hw_session.time.sleep"):
+        s.enable()
+    assert enabled == [True] * 5 + [False]
+    s.api.enable.assert_not_called()
+    assert [c.args[0] for c in s.api.robot.enable.call_args_list] == [1, 2, 3, 4, 5]
+    assert s.passive_joint_fault() is None
+    enabled[5] = True
+    assert s.passive_joint_fault() == "J6 unexpectedly enabled"
+    s.api.robot.get_driver_states.return_value = None
+    s.api.robot.get_driver_states.side_effect = None
+    assert "missing/stale" in s.passive_joint_fault()
+
+
+def test_missing_disabled_ack_never_enables_other_joints():
+    s, _ = session()
+    s.api.robot.get_driver_states.side_effect = lambda j: None
+    with pytest.raises(RuntimeError, match="confirm J6 disabled"):
+        s.enable(timeout_s=.001)
+    s.api.robot.enable.assert_not_called()
+
+
+def test_mode_switch_rechecks_j6_and_stops_automatic_mode_frames():
+    s, enabled = session()
+    s.api.set_mit_mode.side_effect = lambda: enabled.__setitem__(5, True)
+    with patch("gravity_comp.hw_session.time.sleep"):
+        s.set_mit_mode()
+    s.api.robot.set_auto_set_motion_mode_enabled.assert_called_once_with(False)
+    assert enabled[5] is False
+    s.api.move_mit_torque.assert_not_called()
+
+
+def test_no_j6_mit_frame_in_ramp_active_brake_hold_or_done():
+    s, _ = session()
+    gravity = Mock(side_effect=const_gravity)
+    ctrl = DragController(make_config(), gravity)
+    q = Q_MID.copy()
+    q[5] = .4
+    v = np.array([0., 0., 0., 0., 0., .5])  # Passive wrist can keep moving.
+    ctrl.start(q)
+    for dt in (.1, 2.):
+        sent = s.send_mit(ctrl.update(q, v, dt))
+        assert sent[5] == 0
+    ctrl.freeze("test")
+    for dt in (.1, .6, .6):
+        s.send_mit(ctrl.update(q, v, dt))
+    assert ctrl.state == DragState.FREEZE_HOLD
+    ctrl.stop()
+    s.send_mit(ctrl.update(q, v, .01))
+    assert {c.args[0] for c in s.api.move_mit_torque.call_args_list} == {1, 2, 3, 4, 5}
+    assert all(c.args[0][5] == .4 for c in gravity.call_args_list)
+
+
+def test_exception_damp_brake_also_excludes_j6():
+    s, _ = session()
+    s.read_state = Mock(return_value=NS(q=Q_MID.copy()))
+    with patch("gravity_comp.hw_session.time.sleep"), patch("gravity_comp.hw_session.HOLD_RAMP_S", .01):
+        damp_brake(s, const_gravity, duration_s=0)
+    assert {c.args[0] for c in s.api.move_mit_torque.call_args_list} == {1, 2, 3, 4, 5}
+
+
+def test_default_session_still_commands_all_six():
+    s, _ = session()
+    s.disable_j6 = False
+    s.send_mit(t_ff=np.ones(6))
+    assert [c.args[0] for c in s.api.move_mit_torque.call_args_list] == [1, 2, 3, 4, 5, 6]
+
+
+@pytest.mark.parametrize("both", [False, True])
+def test_passive_profile_preserves_original_enable_and_mode_sequence(both):
+    s, _ = session(passive_j6=not both, passive_j5_j6=both)
+    s.api.enable.return_value = True
+    with patch("gravity_comp.hw_session.time.sleep"):
+        s.enable()
+        s.set_mit_mode()
+    s.api.enable.assert_called_once_with(timeout_s=5.0)
+    s.api.set_mit_mode.assert_called_once_with()
+    s.api.robot.enable.assert_not_called()
+    s.api.robot.disable.assert_not_called()
+    s.api.robot.set_auto_set_motion_mode_enabled.assert_not_called()
+    assert s.passive_joint_fault() is None
+
+
+def assert_passive_command(s, cmd, measured_q6):
+    """Check the SDK boundary, preserving other joints and all six frames."""
+    s.api.move_mit_torque.reset_mock()
+    s._last_q = Q_MID.copy()
+    s._last_q[4] = -.6
+    s._last_q[5] = measured_q6
+    sent = s.send_mit(cmd)
+    calls = s.api.move_mit_torque.call_args_list
+    assert [c.args[0] for c in calls] == [1, 2, 3, 4, 5, 6]
+    active_count = 4 if s.passive_j5_j6 else 5
+    for j, call in enumerate(calls[:active_count]):
+        assert call.args[1] == pytest.approx(cmd.t_ff[j] * s.command_scales[j])
+        for name in ("p_des", "v_des", "kp", "kd"):
+            assert call.kwargs[name] == pytest.approx(getattr(cmd, name)[j])
+    for j in range(active_count, 6):
+        assert calls[j].args[1] == sent[j] == 0.0
+        assert calls[j].kwargs == dict(p_des=s._last_q[j], v_des=0., kp=0., kd=0., clamp=True)
+        assert s.last_mit_command["p_des"][j] == s._last_q[j]
+        for name in ("kp", "kd", "v_des"):
+            assert s.last_mit_command[name][j] == 0.
+
+
+@pytest.mark.parametrize("both", [False, True])
+def test_passive_wrist_zeroes_every_control_state_without_changing_other_joints(both):
+    s, _ = session(passive_j6=not both, passive_j5_j6=both)
+    s.command_scales = np.arange(1., 7.)
+    ctrl = DragController(make_config(), const_gravity)
+    q = Q_MID.copy()
+    ctrl.start(q)
+    states = set()
+    for dt in (.1, 2.):
+        cmd = ctrl.update(q, np.zeros(6), dt)
+        original = {name: getattr(cmd, name).copy()
+                    for name in ("t_ff", "p_des", "v_des", "kp", "kd")}
+        assert_passive_command(s, cmd, measured_q6=.7)
+        for name, values in original.items():
+            np.testing.assert_array_equal(getattr(cmd, name), values)
+        states.add(ctrl.state)
+    ctrl.freeze("test")
+    for dt in (.1, .6, .6):
+        assert_passive_command(s, ctrl.update(q, np.zeros(6), dt), measured_q6=.8)
+        states.add(ctrl.state)
+    ctrl.stop()
+    assert_passive_command(s, ctrl.update(q, np.zeros(6), .01), measured_q6=.9)
+    states.add(ctrl.state)
+    assert states == {DragState.RAMP_IN, DragState.ACTIVE, DragState.BRAKE,
+                      DragState.FREEZE_HOLD, DragState.DONE}
+
+
+@pytest.mark.parametrize("both", [False, True])
+def test_passive_wrist_remains_zero_in_exception_damp_brake(both):
+    s, _ = session(passive_j6=not both, passive_j5_j6=both)
+    q = Q_MID.copy()
+    q[4] = -.6
+    q[5] = .9
+    s.read_state = Mock(return_value=NS(q=q))
+    with patch("gravity_comp.hw_session.time.sleep"), patch("gravity_comp.hw_session.HOLD_RAMP_S", .01):
+        damp_brake(s, const_gravity, duration_s=0)
+    calls = s.api.move_mit_torque.call_args_list
+    assert len(calls) >= 12
+    assert [c.args[0] for c in calls] == [1, 2, 3, 4, 5, 6] * (len(calls) // 6)
+    for joint in ((5, 6) if both else (6,)):
+        assert all(c.args[1] == 0 and c.kwargs ==
+                   dict(p_des=q[joint-1], v_des=0., kp=0., kd=0., clamp=True)
+                   for c in calls if c.args[0] == joint)
+    assert any(c.kwargs["kp"] > 0 for c in calls if c.args[0] == 1)
+    assert all(c.args[1] != 0 for c in calls if c.args[0] == 1)
+
+
+@pytest.mark.parametrize("joint,both", [(6, False), (5, True), (6, True)])
+def test_passive_wrist_still_trips_runaway_guard(joint, both):
+    s, _ = session(passive_j6=not both, passive_j5_j6=both)
+    ctrl = DragController(make_config(), const_gravity)
+    ctrl.start(Q_MID)
+    ctrl.update(Q_MID, np.zeros(6), 2.)
+    for _ in range(4):
+        v = np.zeros(6)
+        v[joint-1] = 8.
+        s.send_mit(ctrl.update(Q_MID, v, .01))
+    assert ctrl.freeze_reason == f"runaway J{joint}"
+
+
+@pytest.mark.parametrize("both", [False, True])
+def test_passive_position_reference_uses_last_measured_state(both):
+    s, _ = session(passive_j6=not both, passive_j5_j6=both)
+    q = Q_MID.copy()
+    q[4] = -.6
+    q[5] = -.9
+    s.api.get_joint_state.return_value = NS(joints=q, hz=200., timestamp=time.time())
+    s.api.get_motor_state.return_value = NS(velocities=np.zeros(6), torques=np.zeros(6),
+                                          currents=np.zeros(6), hz=200., timestamp=time.time())
+    s.read_state()
+    s.send_mit(t_ff=np.ones(6), p_des=np.ones(6), kp=3., kd=.8)
+    assert s.api.move_mit_torque.call_args_list[5].kwargs["p_des"] == -.9
+    if both:
+        assert s.api.move_mit_torque.call_args_list[4].kwargs["p_des"] == -.6
+
+
+def test_j6_profiles_are_mutually_exclusive_in_session_and_cli():
+    from gravity_comp.drag_mode import parse_args
+    for first, second in combinations(("disable_j6", "passive_j6", "passive_j5_j6"), 2):
+        with pytest.raises(ValueError, match="mutually exclusive"):
+            HardwareSession("v183", **{first: True, second: True})
+        with pytest.raises(SystemExit) as exc:
+            parse_args(["--" + name.replace("_", "-") for name in (first, second)])
+        assert exc.value.code == 2
+    assert parse_args(["--passive-j6"]).passive_j6
+    assert parse_args(["--passive-j5-j6"]).passive_j5_j6
